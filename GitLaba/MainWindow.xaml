<Window x:Class="GitLaba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitLaba"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="687*"/>
            <ColumnDefinition Width="313*"/>
        </Grid.ColumnDefinitions>
        <Canvas x:Name="Scene" HorizontalAlignment="Center" Height="400" Margin="0,10,0,0"
VerticalAlignment="Top" Width="670"/>
        <Button Content="Clear Screen" Click="Clear" Width="100" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Grid.Column="1"/>
        <Button Content="Redraw" Click="Redraw" Width="100" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,15,0" Grid.Column="1"/>

        <TextBlock Text="Треугольник" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,90,215,0" Grid.Column="1" Width="69"/>
        <TextBlock Text="X             Y" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,110,220,0" Grid.Column="1" Width="56"/>
        <TextBlock Text="P1" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,140,295,0" Width="13" Grid.Column="1"/>
        <TextBlock Text="P2" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,170,295,0" Width="13" Grid.Column="1"/>
        <TextBlock Text="P3" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,295,0" Width="13" Grid.Column="1"/>
        <TextBox x:Name="trP1X" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,140,250,0" Grid.Column="1"/>
        <TextBox x:Name="trP1Y" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,140,200,0" Grid.Column="1"/>
        <TextBox x:Name="trP2X" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,170,250,0" Grid.Column="1"/>
        <TextBox x:Name="trP2Y" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,170,200,0" Grid.Column="1"/>
        <TextBox x:Name="trP3X" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,250,0" Grid.Column="1"/>
        <TextBox x:Name="trP3Y" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,200,0" Grid.Column="1"/>

        <TextBlock Text="Квадрат" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,90,100,0" Grid.Column="1" Width="44"/>
        <TextBlock Text="X             Y" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,110,90,0" Grid.Column="1" Width="56"/>
        <TextBlock Text="P1" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,140,165,0" Grid.Column="1" Width="13"/>
        <TextBlock Text="P2" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,170,165,0" Grid.Column="1" Width="13"/>
        <TextBlock Text="P3" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,165,0" Grid.Column="1" Width="13"/>
        <TextBlock Text="P4" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,230,165,0" Grid.Column="1" Width="13"/>
        <TextBox x:Name="squP1X" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,140,120,0" Grid.Column="1"/>
        <TextBox x:Name="squP1Y" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,140,70,0" Grid.Column="1"/>
        <TextBox x:Name="squP2X" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,170,120,0" Grid.Column="1"/>
        <TextBox x:Name="squP2Y" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,170,70,0" Grid.Column="1"/>
        <TextBox x:Name="squP3X" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,120,0" Grid.Column="1"/>
        <TextBox x:Name="squP3Y" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,70,0" Grid.Column="1"/>
        <TextBox x:Name="squP4X" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,230,120,0" Grid.Column="1"/>
        <TextBox x:Name="squP4Y" Width="40" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,230,70,0" Grid.Column="1"/>
        <Button Content="Нарисовать" Width="100" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,270,120,0" Grid.Column="1" Click="Button_Click"/>
    </Grid>
</Window>
